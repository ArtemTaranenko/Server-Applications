@model IEnumerable<AS_Taranenko_lab1_gr1.Models.Product>
@using System.Linq

@{
    var last = Model.Last();
}
<div class="w3-card">
    
        @foreach (var product in Model)
        {
            @if (product.Equals(last))
            {
                <header class="w3-container w3-green">
                        <h1>
                            Nazwa productu: @product.Name
                        </h1>
                </header>
                <div class="w3-card" style="background-color:white">
                    <h2> Cena productu: @product.Price </h2>
                        @if (product.Category != null)
                        {
                            <h2> Kategoria productu: @product.Category.Name </h2>
                        }

                        <h2>
                            Tagi:
                            @if (product.Tags != null)
                            {
                                @foreach (var tag in product.Tags)
                                {
                            @(tag.Name + " ")
                        }
                            }
                        </h2>
                </div>
            }
            else
            {
                <header class="w3-container w3-purple">
            <h1>
                Nazwa productu: @product.Name
            </h1>
            </header>
             <div class="w3-card" style="background-color:white"> 
                    <h2> Cena productu: @product.Price </h2>
                @if (product.Category != null)
                {
                <h2> Kategoria productu: @product.Category.Name </h2>
            }

            <h2> Tagi: 
            @if (product.Tags != null)
            {
                    @foreach (var tag in product.Tags)
                    {
                           @(tag.Name + " ")
                        }
                }
            </h2>
                </div>
            }
        }

</div>

