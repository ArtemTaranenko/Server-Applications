@model List<AS_Taranenko_lab1_gr1.Models.Student>

<h1>Studenci</h1>
<p>
    <ul>
        @foreach (var student in Model)
        {
            <li>
                <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id">@student.Name @student.Surname</a>
            </li>
        }
    </ul>
</p>
